{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true
  },
  "include": ["app/**/*.js", "app/**/*.jsx", "next.config.mjs"],
  "exclude": ["node_modules", ".next", "out"]
}
